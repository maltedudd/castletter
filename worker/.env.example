# Copy to worker/.env on the Docker host (never commit the real file).

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# Optional (defaults shown)
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# TRANSCRIPTION_POLL_INTERVAL_SECONDS=60
# Only episodes published within this many days are transcribed (backlog scope).
# TRANSCRIPTION_MAX_EPISODE_AGE_DAYS=7
# TRANSCRIPTION_MAX_ATTEMPTS=3
# TRANSCRIPTION_DOWNLOAD_TIMEOUT_SECONDS=120
# Called with GET on every poll, e.g. an n8n webhook or healthchecks.io ping URL.
# TRANSCRIPTION_HEARTBEAT_URL=
# TRANSCRIPTION_HEALTHCHECK_MAX_AGE_SECONDS=1800

# Newsletter pipeline (generation + sending). Off unless set to true.
# Before enabling: set NEWSLETTER_CRON_DISABLED=true in Vercel and pause the
# generate-/send-newsletters jobs on cron-job.org.
# WORKER_NEWSLETTERS_ENABLED=false
# Required when enabled:
# RESEND_API_KEY=
# APP_URL=https://<castletter-domain>
# Optional:
# FROM_EMAIL=Castletter <newsletter@castletter.io>
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Feed check (imports new episodes from the podcast feeds). Off unless set to true.
# Before enabling: set FEED_CHECK_CRON_DISABLED=true in Vercel and pause the
# check-new-episodes job on cron-job.org.
# WORKER_FEED_CHECK_ENABLED=false
# FEED_CHECK_INTERVAL_MINUTES=30
